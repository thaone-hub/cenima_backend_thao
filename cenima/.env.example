# PowerShell: set $env:DB_URL, $env:DB_USERNAME, $env:DB_PASSWORD explicitly.
# Documentation only; Spring does not load this file automatically.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CINEMA_THAO_ETICKET_DEMO;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_application_login
DB_PASSWORD=

# Explicit profile: demo or integrated.
TRADITIONAL_KEY_DIRECTORY=.local/keys/integrated
